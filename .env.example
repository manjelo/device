# RadioSim has no required runtime environment variables. Everything below is optional.
# The real .env stays on the server (mode 600) and is never committed.

# Radio-to-radio relay (service "relay"). Comma-separated browser Origins allowed to connect, e.g.
# RELAY_ALLOWED_ORIGINS=https://radiosim.example.com
# Leave empty to allow only the same origin as the page, which is correct behind the shared Nginx.
RELAY_ALLOWED_ORIGINS=
